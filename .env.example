# =============================================================================
# CivicResolve Root Environment Configuration Template
# =============================================================================
# Copy this file to .env or configure in apps/mobile/.env and apps/web/js/config.js

# Supabase Backend (PostgreSQL + PostGIS + Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini Multimodal Intelligence
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Mapbox / Leaflet Tiles
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here
